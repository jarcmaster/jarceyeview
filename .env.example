# Copia este archivo a ".env" y rellena tus claves.

# OBLIGATORIA para el globo fotorrealista de Google.
# Google Cloud Console -> habilita "Map Tiles API" -> crea una API key.
GOOGLE_MAPS_API_KEY=

# OPCIONAL. Token gratuito de https://ion.cesium.com. Puedes dejarlo vacío.
CESIUM_ION_TOKEN=

# OPCIONAL. OpenSky funciona SIN credenciales (límites bajos). Para más cuota:
# crea cuenta en https://opensky-network.org -> app OAuth2 -> client_id/secret.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Segundos entre consultas a OpenSky (recomendado 8-10).
POLL_INTERVAL=8

# --- Notificaciones a Telegram (rastreo de vuelos y alertas de emergencia) ---
# 1) Habla con @BotFather -> /newbot -> te da el TOKEN.
# 2) Manda un mensaje a tu bot, abre https://api.telegram.org/bot<TOKEN>/getUpdates
#    y copia el "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OPCIONAL. Estado de vuelo (terminal, gate, hora de aterrizaje, delays).
# Registro gratis en https://aviationstack.com (100 consultas/mes en el plan free).
AVIATIONSTACK_KEY=

# OPCIONAL. Webcams en vivo cercanas. Registro gratis en https://api.windy.com
# -> crea una key del producto "Webcams API".
WINDY_WEBCAMS_KEY=

# --- IA LOCAL (recomendado): voz, visión y chat sin nube ---
# Ollama corre modelos de texto y VISIÓN en tu equipo. Instala https://ollama.com
#   ollama serve                       (deja el servidor activo)
#   ollama pull llama3.2-vision        (modelo con visión, para voz + análisis del mapa)
# Host por defecto http://localhost:11434. Deja los modelos vacíos para AUTODETECTAR.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=

# GENERACIÓN de imágenes local (Ollama NO genera imágenes). Usa Stable Diffusion:
# AUTOMATIC1111 -> lanza con  webui-user.bat  añadiendo  --api   (queda en :7860).
SD_HOST=http://localhost:7860
# SD_STEPS=22
# SD_CFG=7
# SD_SAMPLER=DPM++ 2M Karras
# SD_DENOISE=0.55

# OPCIONAL (respaldo en la nube si Ollama no está). https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPCIONAL. TomTom: tráfico en vivo, nombres de calles, reverse-geocoding.
# Registro gratis en https://developer.tomtom.com
TOMTOM_KEY=

# OPCIONAL. Barcos (AIS) en vivo. Registro gratis en https://aisstream.io
AISSTREAM_KEY=
